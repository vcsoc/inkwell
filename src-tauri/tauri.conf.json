{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell Preview",
  "version": "0.2.0-alpha.5",
  "identifier": "app.inkwell.workspace.preview",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Inkwell Preview", "width": 1240, "height": 820,
      "minWidth": 380, "minHeight": 480, "backgroundColor": "#ffffff"
    }],
    "security": {
      "capabilities": ["workspace"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
